# Text files are stored and checked out with LF; Git detects binaries automatically.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Conserved print outputs: keep their original bytes.
output/** -text

# Keep whitespace checks useful.
* whitespace=blank-at-eol,blank-at-eof,space-before-tab
