      "file": "client-web/src/ui.tsx",
      "line": 5,
      "source": "import {frameSvg,type FrameKind} from './frames.ts';"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 6,
      "source": "import {MARK_LAYERS,SYMBOL_LAYERS,svgParts,symbolColors,type Layer,type MarkKind,type SymbolKind} from './symbols.ts';"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 18,
      "source": "<svg className=\"card-frame\" viewBox={`${-w/2-1} ${-h/2-1} ${w+2} ${h+2}`} aria-hidden=\"true\">{frameSvg(kind,w,h).map((p,i)=>React.createElement(p.tag,{key:i,...p.attrs}))}</svg>;"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 25,
      "source": "<SvgMark layers={SYMBOL_LAYERS[kind]} colors={colors??symbolColors(kind)} className={className} px={px}/>;"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 27,
      "source": "export const Mark=({kind,className}:{kind:MarkKind;className?:string})=><SvgMark layers={MARK_LAYERS[kind]} colors={{main:'currentColor'}} className={`mark${className?` ${className}`:''}`} px={20}/>;"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 29,
      "source": "export const DamageMark=({type}:{type:DamageType})=><SvgMark layers={SYMBOL_LAYERS[type]} colors={{main:hex(DAMAGE_COLOR[type]),accent:hex(DAMAGE_ACCENT[type])}} className=\"dmg-mark\" data={{'data-damage':type}}/>;"
    },
    {
      "file": "client-web/src/ui.tsx",
      "line": 40,
      "source": "return <span className=\"gains\" data-testid=\"gains\">{gains.map(g=><span key={g.resource} className=\"gain\" role=\"img\" aria-label={`+${g.amount??'x'} ${resourceNames[g.resource].toLowerCase()}`} style={{borderColor:hex(RES_COLOR[g.resource])}}>+{g.amount??'x'}<SymbolMark kind={g.resource} className=\"res-mark\"/></span>)}</span>;"
    }
  ],
