+// C4-11 Phase A PROTOTYPE, not product: it lives only in docs/design/client-c4/spazio/prototipo.patch.
+// Options are switched on by localStorage 'bm.space', a list such as "a1,b1,c2,d" (see spazio/proposta.md); without the key the
+// client behaves exactly as the product. Read once per page load, so fitScale's cache stays valid.
+// On a phone without a console: ?space=c2,d (and ?safe=l,t,r,b) in the address stores the choice; ?space= with nothing clears it.
+try{const q=new URLSearchParams(globalThis.location?.search??'');for(const [p,k] of [['space','bm.space'],['safe','bm.safe']] as const){const v=q.get(p);if(v!==null){if(v)globalThis.localStorage?.setItem(k,v);else globalThis.localStorage?.removeItem(k);}}}catch{}
+const raw=(()=>{try{return globalThis.localStorage?.getItem('bm.space')??'';}catch{return '';}})();
+const flags=new Set(raw.split(/[\s,;]+/).map(s=>s.trim().toLowerCase()).filter(Boolean));
+export const space=(f:string)=>flags.has(f);
+export const spaceFlags=[...flags];
