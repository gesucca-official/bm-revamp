+ if(!space('d')&&!space('d2'))return {l:0,t:0,r:0,b:0};
+ try{const fake=globalThis.localStorage?.getItem('bm.safe');if(fake){const [l,t,r,b]=fake.split(',').map(Number);return {l:l||0,t:t||0,r:r||0,b:b||0};}}catch{}
